# Server
NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/ash_quick_pay
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Admin (never expose to clients — use X-Admin-Key header)
ADMIN_API_KEY=change_me_admin_key

# bKash (Checkout URL mode 0011) — server-side only
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# Sandbox: use bKash sandbox base; production: URL from onboarding
BKASH_SANDBOX=true
# Optional override (defaults to sandbox URL when BKASH_SANDBOX=true)
# BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta

# HTTPS callback base used by bKash redirects (must be reachable publicly in prod)
BKASH_CALLBACK_BASE_URL=https://your-frontend.example.com

# Local testing without calling bKash (still hits MongoDB)
BKASH_USE_MOCK=false

# CORS: * or comma-separated origins (include Vite dev server when using JWT from the browser)
# CORS_ORIGIN=http://localhost:8080,http://127.0.0.1:8080
CORS_ORIGIN=*
